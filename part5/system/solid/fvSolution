FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver          PCG;
        preconditioner  DIC;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.01;
    }

    hFinal
    {
        $h;
        tolerance       1e-08;
        relTol          0.001;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        "(h|e)"         1.0;
        "(h|e)Final"    1.0;
    }
}

