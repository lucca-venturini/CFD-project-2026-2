// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.02;

deltaT          0.00005;

writeControl    adjustableRunTime;

writeInterval   0.002;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           5.0;

maxDi           100000.0;

maxDeltaT       0.00005;

functions
{
    residualsFluid
    {
        type            solverInfo;
        libs            ( "libutilityFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        fields          ( p_rgh U k omega h );
    }

    residualsSolid
    {
        type            solverInfo;
        libs            ( "libutilityFunctionObjects.so" );
        region          solid;
        writeControl    timeStep;
        writeInterval   1;
        fields          ( h );
    }

    courantNo
    {
        type            CourantNo;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    courantExtrema
    {
        type            fieldMinMax;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        mode            magnitude;
        fields          ( Co U );
    }

    fluidTempExtrema
    {
        type            fieldMinMax;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        mode            component;
        fields          ( T p );
    }

    solidTempExtrema
    {
        type            fieldMinMax;
        libs            ( "libfieldFunctionObjects.so" );
        region          solid;
        writeControl    timeStep;
        writeInterval   1;
        mode            component;
        fields          ( T );
    }

    solidTempAvg
    {
        type            volFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          solid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      all;
        operation       volAverage;
        fields          ( T h );
    }

    fluidTempAvg
    {
        type            volFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      all;
        operation       volAverage;
        fields          ( T h );
    }

    interfaceTempFluid
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            fluid_to_solid;
        operation       areaAverage;
        fields          ( T );
    }

    interfaceTempFluidMax
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            fluid_to_solid;
        operation       max;
        fields          ( T p );
    }

    interfaceTempSolid
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          solid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            solid_to_fluid;
        operation       areaAverage;
        fields          ( T );
    }

    inletTemperatureMix
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            inlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( T h );
    }

    outletTemperatureMix
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            outlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( T h );
    }

    massFlowInlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          ( phi );
    }

    massFlowOutlet
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            outlet;
        operation       sum;
        fields          ( phi );
    }

    inletPressure
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            inlet;
        operation       areaAverage;
        fields          ( p );
    }

    outletPressure
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            outlet;
        operation       areaAverage;
        fields          ( p );
    }

    pressureUpstreamCube
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      sampledSurface;
        name            zUpstream030;
        operation       areaAverage;
        fields          ( p );
        sampledSurfaceDict
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point           ( 0.1 0.1 0.3 );
                normal          ( 0 0 1 );
            }
            interpolate     true;
        }
    }

    pressureDownstreamCube
    {
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      sampledSurface;
        name            zDownstream055;
        operation       areaAverage;
        fields          ( p );
        sampledSurfaceDict
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point           ( 0.1 0.1 0.55 );
                normal          ( 0 0 1 );
            }
            interpolate     true;
        }
    }

    wallHeatFlux
    {
        type            wallHeatFlux;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        patches         ( fluid_to_solid walls );
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    yPlus
    {
        type            yPlus;
        libs            ( "libfieldFunctionObjects.so" );
        region          fluid;
        executeControl  writeTime;
        writeControl    writeTime;
        patches         ( walls fluid_to_solid );
    }

    fluidProbes
    {
        type            probes;
        libs            ( "libsampling.so" );
        region          fluid;
        writeControl    timeStep;
        writeInterval   1;
        fields          ( U p T );
        probeLocations
        (
            ( 0.100     0.025   0.300     )
            ( 0.100     0.060   0.425     )
            ( 0.100     0.025   0.475     )
            ( 0.100     0.025   0.550     )
            ( 0.100     0.025   0.650     )
            ( 0.100     0.025   1.000     )
            ( 0.1250125 0.01135 0.41971   )
            ( 0.100     0.025   0.4500125 )
        );
    }

    solidProbes
    {
        type            probes;
        libs            ( "libsampling.so" );
        region          solid;
        writeControl    timeStep;
        writeInterval   1;
        fields          ( T );
        probeLocations
        (
            ( 0.1 0.025 0.425 )
            ( 0.1 0.002 0.425 )
            ( 0.1 0.048 0.425 )
        );
    }
}

