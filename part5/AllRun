#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Part V: Transient Conjugate Heat Transfer (chtMultiRegionFoam)
# Pipeline: Resume check -> (AllClean + mesh verify + decomposePar) -> chtMultiRegionFoam
#           + auto-wired live monitor_postprocessing.py -> reconstructPar
# -----------------------------------------------------------------------------
cd "${0%/*}" || exit 1

if [ -f "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" ]; then
    source "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" || true
fi

set -e

MONITOR_PID=""
SOLVER_PID=""

cleanup_exit() {
    if [ -n "$MONITOR_PID" ] && kill -0 "$MONITOR_PID" 2>/dev/null; then
        kill -TERM "$MONITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$SOLVER_PID" ] && kill -0 "$SOLVER_PID" 2>/dev/null; then
        echo -e "\n[!] Caught interrupt signal. Terminating solver (PID: $SOLVER_PID)..."
        kill -TERM "$SOLVER_PID" 2>/dev/null || true
    fi
}
trap cleanup_exit INT TERM

echo "=========================================================="
echo " Part V: Transient CHT (chtMultiRegionFoam)"
echo "=========================================================="

if [ ! -f "system/controlDict" ] || [ ! -f "system/decomposeParDict" ]; then
    echo "[-] Error: 'system/controlDict' or 'system/decomposeParDict' not found." >&2
    exit 1
fi

pkill -f "part5/monitor_postprocessing.py" 2>/dev/null || true
pkill -f "monitor_postprocessing.py" 2>/dev/null || true

NUM_PROCS=$(awk '/^[[:space:]]*numberOfSubdomains[[:space:]]+/{gsub(/;/,""); print $2; exit}' system/decomposeParDict)
END_TIME=$(awk '/^[[:space:]]*endTime[[:space:]]+/{gsub(/;/,""); print $2; exit}' system/controlDict)
EXISTING_PROCS=$(find . -maxdepth 1 -type d -name 'processor[0-9]*' 2>/dev/null | wc -l | tr -d ' ')
LATEST_CKPT=""
if [ -d "processor0" ]; then
    LATEST_CKPT=$(ls -1 processor0 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?$' | sort -g | tail -n 1 || true)
fi

if [ -z "$NUM_PROCS" ] || [ "$NUM_PROCS" -lt 1 ]; then
    echo "[-] Error: Unable to determine valid 'numberOfSubdomains' from system/decomposeParDict." >&2
    exit 1
fi

RESUME_RUN=0
if [ -n "$END_TIME" ] && [ -n "$LATEST_CKPT" ] && [ "$EXISTING_PROCS" -eq "$NUM_PROCS" ]; then
    if awk -v t="$LATEST_CKPT" -v end="$END_TIME" 'BEGIN { exit !(t > 0 && t < end) }'; then
        RESUME_RUN=1
    fi
fi

sed -i '' -E 's/^([[:space:]]*startFrom[[:space:]]+)[^;]+;/\1latestTime;/' system/controlDict

if [ "$RESUME_RUN" -eq 1 ]; then
    echo "[+] Detected in-progress checkpoint at t = $LATEST_CKPT s (endTime = $END_TIME s). Resuming without cleaning..."
else
    ./AllClean

    if [ ! -f "constant/fluid/polyMesh/points" ] || [ ! -f "constant/solid/polyMesh/points" ]; then
        echo "[1/5] Multi-region mesh missing; rebuilding via blockMesh -> topoSet -> splitMeshRegions..."
        blockMesh > log.blockMesh 2>&1
        topoSet > log.topoSet 2>&1
        splitMeshRegions -cellZones -overwrite > log.splitMeshRegions 2>&1
        rm -rf 0
        cp -r 0.orig 0
    else
        echo "[1/5] Using existing multi-region mesh in constant/{fluid,solid}/polyMesh (0/ restored from 0.orig/)."
    fi

    echo "[2/5] Running checkMesh -allRegions..."
    checkMesh -allRegions > log.checkMesh 2>&1 || true

    echo "[3/5] Decomposing regions: decomposePar -allRegions -force ($NUM_PROCS subdomains)..."
    decomposePar -allRegions -force > log.decomposePar 2>&1
fi

echo "[4/5] Launching mpirun -np $NUM_PROCS chtMultiRegionFoam -parallel..."
if [ "$RESUME_RUN" -eq 1 ]; then
    mpirun -np "$NUM_PROCS" chtMultiRegionFoam -parallel >> log.chtMultiRegionFoam 2>&1 &
else
    mpirun -np "$NUM_PROCS" chtMultiRegionFoam -parallel > log.chtMultiRegionFoam 2>&1 &
fi
SOLVER_PID=$!
caffeinate -dims -w "$SOLVER_PID" >/dev/null 2>&1 &
echo "    -> Solver PID: $SOLVER_PID (caffeinate active)"
echo "    -> Monitor log with: tail -f log.chtMultiRegionFoam"

if command -v python3 >/dev/null 2>&1 && [ -f "monitor_postprocessing.py" ]; then
    sleep 2
    echo "    -> Launching live transient CHT monitor (monitor_postprocessing.py)..."
    python3 monitor_postprocessing.py --interval 1.5 &
    MONITOR_PID=$!
    echo "    -> Monitor PID: $MONITOR_PID"
fi

SOLVER_STATUS=0
wait "$SOLVER_PID" || SOLVER_STATUS=$?

if [ "$SOLVER_STATUS" -eq 0 ]; then
    echo "[5/5] Solver finished! Running reconstructPar -allRegions -newTimes..."
    reconstructPar -allRegions -newTimes > log.reconstructPar 2>&1
    echo "[+] Part V transient CHT simulation complete and reconstructed."
else
    echo "[!] chtMultiRegionFoam exited with code $SOLVER_STATUS. Check log.chtMultiRegionFoam."
    exit "$SOLVER_STATUS"
fi
