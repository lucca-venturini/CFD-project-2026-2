FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Blended Crank-Nicolson (0.5) for U/p and bounded Euler for turbulence scalars
    default         CrankNicolson 0.5;
    ddt(k)          Euler;
    ddt(omega)      Euler;
}

gradSchemes
{
    default         cellLimited Gauss linear 1.0;

    grad(U)         cellMDLimited Gauss linear 1.0;
    grad(k)         cellLimited Gauss linear 1.0;
    grad(omega)     cellLimited Gauss linear 1.0;
}

divSchemes
{
    default         none;

    div(phi,U)      Gauss linearUpwind grad(U);
    div(phi,k)      Gauss limitedLinear 1.0;
    div(phi,omega)  Gauss limitedLinear 1.0;

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

wallDist
{
    method          meshWave;
}

