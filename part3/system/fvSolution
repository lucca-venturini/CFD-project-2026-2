FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.05;
        smoother        DICGaussSeidel;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 1000;
        maxIter         25;
    }

    pFinal
    {
        $p;
        tolerance       1e-06;
        relTol          0.02;
        maxIter         30;
    }

    "(U|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0.01;
    }

    "(U|k|omega)Final"
    {
        $U;
        tolerance       1e-06;
        relTol          0.01;
    }
}

PIMPLE
{
    nOuterCorrectors            2;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    0;
    turbOnFinalIterOnly         false;
}

relaxationFactors
{
    fields
    {
        p               0.4;
        pFinal          0.7;
    }
    equations
    {
        "(U|k|omega)"       0.7;
        "(U|k|omega)Final"  0.8;
    }
}

