FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   0.001; // m to mm

vertices
(
    (0 0 0)         // 0
    (200 0 0)       // 1
    (200 200 0)     // 2
    (0 200 0)       // 3
    (0 0 1500)      // 4
    (200 0 1500)    // 5
    (200 200 1500)  // 6
    (0 200 1500)    // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (90 90 150) //n cells in x, y, z directions
    simpleGrading
    (
        // x-direction: symmetric grading towards both sidewalls
        (
            (0.5 0.5 360)
            (0.5 0.5 0.002778)
        )
        // y-direction: symmetric grading towards top and bottom walls
        (
            (0.5 0.5 360)
            (0.5 0.5 0.002778)
        )
        // z-direction: uniform grading
        1
    )
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    walls
    {
        type wall;
        faces
        (
            (0 4 7 3)   // x = 0
            (1 2 6 5)   // x = 200
            (0 1 5 4)   // y = 0
            (3 7 6 2)   // y = 200
        );
    }
);

