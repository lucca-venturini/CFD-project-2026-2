#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Integrated OpenFOAM Execution Pipeline (Allrun)
# Workflow: Clean -> blockMesh -> decomposePar -> mpirun -> monitor -> Hold
# -----------------------------------------------------------------------------
cd "${0%/*}" || exit 1

if [ -f "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" ]; then
    source "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" || true
fi

set -e

# Trap interrupts (Ctrl+C) to ensure background MPI & monitor processes are terminated
cleanup_exit() {
    if [ -n "$MONITOR_PID" ] && kill -0 "$MONITOR_PID" 2>/dev/null; then
        kill -TERM "$MONITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$SOLVER_PID" ] && kill -0 "$SOLVER_PID" 2>/dev/null; then
        echo -e "\n[!] Caught exit signal. Terminating solver (PID: $SOLVER_PID)..."
        kill -TERM "$SOLVER_PID" 2>/dev/null || true
    fi
}
trap cleanup_exit INT TERM

# 0. Directory validation & checkpoint detection
if [ ! -f "system/controlDict" ]; then
    echo "[-] Error: 'system/controlDict' not found. Run this script from the case root." >&2
    exit 1
fi

if [ ! -f "system/decomposeParDict" ]; then
    echo "[-] Error: 'system/decomposeParDict' not found. Cannot proceed with parallel execution." >&2
    exit 1
fi

pkill -f "monitor_postprocessing.py" 2>/dev/null || true

NUM_PROCS=$(awk '/^[[:space:]]*numberOfSubdomains[[:space:]]+/{gsub(/;/,""); print $2; exit}' system/decomposeParDict)
END_TIME=$(awk '/^[[:space:]]*endTime[[:space:]]+/{gsub(/;/,""); print $2; exit}' system/controlDict)
EXISTING_PROCS=$(find . -maxdepth 1 -type d -name 'processor[0-9]*' 2>/dev/null | wc -l | tr -d ' ')
LATEST_CKPT=""
if [ -d "processor0" ]; then
    LATEST_CKPT=$(ls -1 processor0 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+)?$' | sort -n | tail -n 1 || true)
fi

if [ -z "$NUM_PROCS" ] || [ "$NUM_PROCS" -lt 1 ]; then
    echo "[-] Error: Unable to determine valid 'numberOfSubdomains' from system/decomposeParDict." >&2
    exit 1
fi

RESUME_RUN=0
if [ -n "$END_TIME" ] && [ -n "$LATEST_CKPT" ] && [ "$EXISTING_PROCS" -eq "$NUM_PROCS" ]; then
    if awk -v t="$LATEST_CKPT" -v end="$END_TIME" 'BEGIN { exit !(t > 0 && t < end) }'; then
        RESUME_RUN=1
    fi
fi

sed -i '' -E 's/^([[:space:]]*startFrom[[:space:]]+)[^;]+;/\1latestTime;/' system/controlDict

if [ "$RESUME_RUN" -eq 1 ]; then
    echo "=========================================================="
    echo " [+] Detected in-progress checkpoint at t = $LATEST_CKPT (endTime = $END_TIME). Resuming without cleaning..."
    echo "=========================================================="
else
    # -----------------------------------------------------------------------------
    # 1. CLEAN
    # -----------------------------------------------------------------------------
    echo "=========================================================="
    echo " [1/5] Cleaning case directory"
    echo "=========================================================="

    # Remove previous solution times, post-processing, and parallel directories
    rm -rf [1-9]* 0.[0-9]* postProcessing processor* log.* *.log VTK

    # Reset 0/ directory if 0.orig template exists
    if [ -d "0.orig" ]; then
        echo " [*] Restoring '0/' from '0.orig/'..."
        rm -rf 0
        cp -r 0.orig 0
    fi

    # Clean generated mesh files while protecting blockMeshDict
    if [ -d "constant/polyMesh" ]; then
        if [ -f "constant/polyMesh/blockMeshDict" ]; then
            find constant/polyMesh -mindepth 1 ! -name 'blockMeshDict' -delete
        else
            rm -rf constant/polyMesh
        fi
    fi

    # -----------------------------------------------------------------------------
    # 2. MESH GENERATION (blockMesh)
    # -----------------------------------------------------------------------------
    echo "=========================================================="
    echo " [2/5] Generating mesh: blockMesh"
    echo "=========================================================="
    if ! blockMesh > log.blockMesh 2>&1; then
        echo "[-] Fatal: blockMesh failed. Check log.blockMesh for details." >&2
        exit 1
    fi
    echo " [+] blockMesh completed successfully."

    # -----------------------------------------------------------------------------
    # 3. DOMAIN DECOMPOSITION (decomposePar)
    # -----------------------------------------------------------------------------
    echo "=========================================================="
    echo " [3/5] Decomposing domain: decomposePar"
    echo "=========================================================="
    echo " [*] Target processor count: $NUM_PROCS"

    if ! decomposePar > log.decomposePar 2>&1; then
        echo "[-] Fatal: decomposePar failed. Check log.decomposePar for details." >&2
        exit 1
    fi
    echo " [+] Decomposition completed ($NUM_PROCS subdomains created)."
fi

# -----------------------------------------------------------------------------
# 4. SOLVER EXECUTION (mpirun simpleFoam)
# -----------------------------------------------------------------------------
echo "=========================================================="
echo " [4/5] Launching solver: mpirun -np $NUM_PROCS simpleFoam -parallel"
echo "=========================================================="

if [ "$RESUME_RUN" -eq 1 ]; then
    mpirun -np "$NUM_PROCS" simpleFoam -parallel >> log.simpleFoam 2>&1 &
else
    mpirun -np "$NUM_PROCS" simpleFoam -parallel > log.simpleFoam 2>&1 &
fi
SOLVER_PID=$!
caffeinate -dims -w "$SOLVER_PID" >/dev/null 2>&1 &
echo " [*] Solver running in background (PID: $SOLVER_PID)."
echo " [*] Tail solver output with: tail -f log.simpleFoam"

# -----------------------------------------------------------------------------
# 5. LIVE DASHBOARD MONITORING
# -----------------------------------------------------------------------------
echo "=========================================================="
echo " [5/5] Attaching real-time monitoring dashboard"
echo "=========================================================="

if command -v python3 >/dev/null 2>&1 && [ -f "monitor_postprocessing.py" ]; then
    sleep 2
    python3 monitor_postprocessing.py &
    MONITOR_PID=$!
    echo " [*] Live monitor attached (PID: $MONITOR_PID)."
else
    echo "[-] Warning: 'monitor_postprocessing.py' not found or python3 unavailable. Skipping GUI monitor."
fi

# -----------------------------------------------------------------------------
# 6. COMPLETION & HOLD
# -----------------------------------------------------------------------------
echo "=========================================================="
echo " [*] Waiting for solver background job (PID: $SOLVER_PID) to finalize..."
SOLVER_STATUS=0
wait "$SOLVER_PID" || SOLVER_STATUS=$?

echo ""
if [ $SOLVER_STATUS -eq 0 ]; then
    echo "[+] Simulation finished successfully."
else
    echo "[-] Simulation exited with error code $SOLVER_STATUS. Check log.simpleFoam."
fi

# Reconstruct parallel fields if solver succeeded
if [ $SOLVER_STATUS -eq 0 ] && [ -d "processor0" ]; then
    read -rp "Reconstruct parallel fields now? [y/N]: " RECON_CONFIRM
    if [[ "$RECON_CONFIRM" =~ ^[Yy]$ ]]; then
        echo " [*] Running reconstructPar -latestTime..."
        reconstructPar -latestTime > log.reconstructPar 2>&1
        echo " [+] Reconstruction complete."
    fi
fi

echo ""
echo "=========================================================="
read -rp "Pipeline finished. Press [Enter] to exit..."