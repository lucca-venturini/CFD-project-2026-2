#!/usr/bin/env bash
# ----------------------------------------------------------------------
# OpenFOAM Case Cleanup Script
# Safely resets the directory for repeated simulation runs.
# ----------------------------------------------------------------------
set -e

# Safety check: Prevent running in an arbitrary folder
if [ ! -f "system/controlDict" ]; then
    echo "[-] Error: 'system/controlDict' not found. Run this script from the OpenFOAM case root." >&2
    exit 1
fi

echo "[*] Cleaning OpenFOAM case..."

# 1. Remove calculated time step directories (preserves 0/)
# Matches numbers starting with 1-9 and floating-point times like 0.001
rm -rf [1-9]* 0.[0-9]*

# 2. Reset 0/ directory if a pristine 0.orig/ template exists
if [ -d "0.orig" ]; then
    echo "[*] Restoring '0/' from '0.orig/'..."
    rm -rf 0
    cp -r 0.orig 0
fi

# 3. Remove post-processing outputs and function object data
rm -rf postProcessing

# 4. Remove parallel decomposition folders
rm -rf processor*

# 5. Clean generated mesh files in constant/polyMesh
# Protects blockMeshDict if it happens to be stored inside polyMesh instead of system/
if [ -d "constant/polyMesh" ]; then
    if [ -f "constant/polyMesh/blockMeshDict" ]; then
        find constant/polyMesh -mindepth 1 ! -name 'blockMeshDict' -delete
    else
        rm -rf constant/polyMesh
    fi
fi

# 6. Remove execution logs, dynamic code compilations, and visualization dumps
rm -rf log.* *.log VTK dynamicCode __pycache__ *.pyc

echo "[+] Case cleaned successfully. Ready for execution."