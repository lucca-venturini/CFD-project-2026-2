#!/usr/bin/env bash
cd "${0%/*}" || exit 1

cleanup_exit() {
    if [ -n "$MONITOR_PID" ] && kill -0 "$MONITOR_PID" 2>/dev/null; then
        kill -TERM "$MONITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$SOLVER_PID" ] && kill -0 "$SOLVER_PID" 2>/dev/null; then
        echo -e "\n[!] Caught interrupt signal. Terminating solver (PID: $SOLVER_PID)..."
        kill -TERM "$SOLVER_PID" 2>/dev/null || true
    fi
}
trap cleanup_exit INT TERM

# =============================================================================
# Part IV: Distributed 2-Node Cluster Execution (8 M2 Pro P-cores + 4 M4 P-cores)
# =============================================================================
WORKER_IP="10.0.0.2"
WORKER_USER="luccaventurini"
MASTER_CORES=8
WORKER_CORES=4
TOTAL_CORES=$((MASTER_CORES + WORKER_CORES))
CASE_DIR="$(pwd)"

if [ -f "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" ]; then
    source "/Volumes/OpenFOAM/openfoam2506/etc/bashrc" || true
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-$DYLD_LIBRARY_PATH}"
else
    echo "[!] Error: /Volumes/OpenFOAM/openfoam2506/etc/bashrc not found."
    exit 1
fi

echo "=================================================================="
echo " Part IV: Steady CHT — 8+4 Cluster Execution (${TOTAL_CORES} P-cores)"
echo "=================================================================="

# Connectivity check
ping -c 1 -W 1000 "${WORKER_IP}" > /dev/null 2>&1 || { echo "[!] Worker unreachable."; exit 1; }
ssh -o BatchMode=yes -o ConnectTimeout=5 "${WORKER_USER}@${WORKER_IP}" "test -d '$WM_PROJECT_DIR'" || { echo "[!] OpenFOAM mount missing on worker."; exit 1; }

pkill -f "monitor_postprocessing.py" 2>/dev/null || true

END_TIME=$(awk '/^[[:space:]]*endTime[[:space:]]+/{gsub(/;/,""); print $2; exit}' system/controlDict)
EXISTING_PROCS=$(find . -maxdepth 1 -type d -name 'processor[0-9]*' 2>/dev/null | wc -l | tr -d ' ')
LATEST_CKPT=""
if [ -d "processor0" ]; then
    LATEST_CKPT=$(ls -1 processor0 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+)?$' | sort -n | tail -n 1 || true)
fi

RESUME_RUN=0
if [ -n "$END_TIME" ] && [ -n "$LATEST_CKPT" ] && [ "$EXISTING_PROCS" -eq "$TOTAL_CORES" ]; then
    if awk -v t="$LATEST_CKPT" -v end="$END_TIME" 'BEGIN { exit !(t > 0 && t < end) }'; then
        RESUME_RUN=1
    fi
fi

sed -i '' -E 's/^([[:space:]]*startFrom[[:space:]]+)[^;]+;/\1latestTime;/' system/controlDict

cat <<EOF > cluster_hostfile
localhost slots=${MASTER_CORES} max_slots=${MASTER_CORES}
${WORKER_IP} slots=${WORKER_CORES} max_slots=${WORKER_CORES}
EOF

if [ "$RESUME_RUN" -eq 1 ]; then
    echo "[+] Detected in-progress checkpoint at t = $LATEST_CKPT (endTime = $END_TIME). Resuming without cleaning..."
    echo "[*] Syncing system/ and constant/ to Worker (${WORKER_IP}) while preserving checkpoints..."
    ssh "${WORKER_USER}@${WORKER_IP}" "mkdir -p '${CASE_DIR}'"
    rsync -a -e ssh \
        "${CASE_DIR}/constant" \
        "${CASE_DIR}/system" \
        "${WORKER_USER}@${WORKER_IP}:${CASE_DIR}/" > log.rsync_out 2>&1
else
    ./AllClean

    blockMesh > log.blockMesh 2>&1
    topoSet > log.topoSet 2>&1
    splitMeshRegions -cellZones -overwrite > log.splitMeshRegions 2>&1

    rm -rf 0
    mkdir -p 0
    cp -r 0.orig/fluid 0/fluid
    cp -r 0.orig/solid 0/solid

    checkMesh -allRegions > log.checkMesh 2>&1 || true

    for d in system/decomposeParDict system/fluid/decomposeParDict system/solid/decomposeParDict; do
        sed -i '' "s/numberOfSubdomains.*/numberOfSubdomains  ${TOTAL_CORES};/" "$d"
    done

    decomposePar -allRegions -force > log.decomposePar 2>&1

    ssh "${WORKER_USER}@${WORKER_IP}" "mkdir -p '${CASE_DIR}'"
    rsync -a --delete -e ssh \
        "${CASE_DIR}/0" \
        "${CASE_DIR}/constant" \
        "${CASE_DIR}/system" \
        "${CASE_DIR}/processor"* \
        "${WORKER_USER}@${WORKER_IP}:${CASE_DIR}/" > log.rsync_out 2>&1
fi

MPI_FLAGS="--prefix $MPI_ARCH_PATH --hostfile cluster_hostfile \
--mca btl_tcp_if_include 10.0.0.0/24 --mca oob_tcp_if_include 10.0.0.0/24 \
-x PATH -x LD_LIBRARY_PATH -x DYLD_LIBRARY_PATH -x WM_PROJECT_DIR -x FOAM_USER_APPBIN -x FOAM_APPBIN"

echo "[*] Launching distributed chtMultiRegionSimpleFoam (${TOTAL_CORES} P-cores)..."
if [ "$RESUME_RUN" -eq 1 ]; then
    mpirun ${MPI_FLAGS} -np ${TOTAL_CORES} --report-bindings chtMultiRegionSimpleFoam -parallel >> log.chtMultiRegionSimpleFoam 2>&1 &
else
    mpirun ${MPI_FLAGS} -np ${TOTAL_CORES} --report-bindings chtMultiRegionSimpleFoam -parallel > log.chtMultiRegionSimpleFoam 2>&1 &
fi
SOLVER_PID=$!
caffeinate -dims -w $SOLVER_PID &
ssh "${WORKER_USER}@${WORKER_IP}" "nohup caffeinate -dims -t 36000 >/dev/null 2>&1 &"
echo "    -> Solver PID: $SOLVER_PID (caffeinate active on Master & Worker)"

if command -v python3 >/dev/null 2>&1 && [ -f "monitor_postprocessing.py" ]; then
    sleep 2
    echo "    -> Launching live thermal & convergence monitor (monitor_postprocessing.py)..."
    python3 monitor_postprocessing.py --interval 1.5 &
    MONITOR_PID=$!
    echo "    -> Monitor PID: $MONITOR_PID"
fi

SOLVER_STATUS=0
wait "$SOLVER_PID" || SOLVER_STATUS=$?

if [ "$SOLVER_STATUS" -eq 0 ]; then
    echo "[*] Distributed chtMultiRegionSimpleFoam finished! Syncing worker processors..."
    for p in $(seq "$MASTER_CORES" $((TOTAL_CORES - 1))); do
        rsync -a -e ssh "${WORKER_USER}@${WORKER_IP}:${CASE_DIR}/processor${p}" "${CASE_DIR}/" >> log.rsync_in 2>&1
    done
    echo "[*] Running reconstructPar -allRegions -latestTime..."
    reconstructPar -allRegions -latestTime > log.reconstructPar 2>&1
    echo "[+] Part IV cluster run complete and latest time reconstructed."
else
    echo "[!] chtMultiRegionSimpleFoam exited with code $SOLVER_STATUS. Check log.chtMultiRegionSimpleFoam."
    exit "$SOLVER_STATUS"
fi
