FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dense metallic cube properties (Alloy Steel / Dense Metallic Block)
// rho_s = 8000 kg/m^3, Cp_s = 500 J/(kg.K), kappa_s = 50 W/(m.K)
// -------------------------------------------------------------------------

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       55.845;
    }
    transport
    {
        kappa           50.0;
    }
    thermodynamics
    {
        Hf              0;
        Sf              0;
        Cp              500.0;
    }
    equationOfState
    {
        rho             8000.0;
    }
}

