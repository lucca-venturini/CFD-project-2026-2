FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      3;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    // -------------------------------------------------------------------------
    // 1. Residual Tracking (logged each iteration to postProcessing/residuals)
    // -------------------------------------------------------------------------
    residuals
    {
        type            solverInfo;
        libs            ("libutilityFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (p U k omega);
    }

    // -------------------------------------------------------------------------
    // 2. Pressure Loss Tracking: Inlet, Upstream/Downstream of Cube, Outlet
    // -------------------------------------------------------------------------
    inletPressure
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            inlet;
        operation       areaAverage;
        fields          (p);
    }

    pressureUpstreamCube
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      sampledSurface;
        name            zUpstream030;
        operation       areaAverage;
        fields          (p);
        sampledSurfaceDict
        {
            type        cuttingPlane;
            planeType   pointAndNormal;
            pointAndNormalDict
            {
                point   (0.1 0.1 0.30);
                normal  (0 0 1);
            }
            interpolate true;
        }
    }

    pressureDownstreamCube
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      sampledSurface;
        name            zDownstream055;
        operation       areaAverage;
        fields          (p);
        sampledSurfaceDict
        {
            type        cuttingPlane;
            planeType   pointAndNormal;
            pointAndNormalDict
            {
                point   (0.1 0.1 0.55);
                normal  (0 0 1);
            }
            interpolate true;
        }
    }

    pressureWakeRecovery
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      sampledSurface;
        name            zWake090;
        operation       areaAverage;
        fields          (p);
        sampledSurfaceDict
        {
            type        cuttingPlane;
            planeType   pointAndNormal;
            pointAndNormalDict
            {
                point   (0.1 0.1 0.90);
                normal  (0 0 1);
            }
            interpolate true;
        }
    }

    // -------------------------------------------------------------------------
    // 3. Mass Flux Balance (phi)
    // -------------------------------------------------------------------------
    massFlowInlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          (phi);
    }

    massFlowOutlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        writeFields     false;
        surfaceFormat   none;
        regionType      patch;
        name            outlet;
        operation       sum;
        fields          (phi);
    }

    // -------------------------------------------------------------------------
    // 4. Field Extrema (Max Local Velocity, Pressure, Turbulent Kinetic Energy)
    // -------------------------------------------------------------------------
    fieldExtrema
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   5;
        mode            magnitude;
        fields          (U p k);
    }

    // -------------------------------------------------------------------------
    // 5. Boundary Layer & Wall Shear Verification (Duct Walls + Cube Surfaces)
    // -------------------------------------------------------------------------
    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
        patches         (walls cube);
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
        patches         (walls cube);
    }
}

